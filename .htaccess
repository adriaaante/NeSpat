# НЕ СПАТЬ МОСКВА — статический сайт (Apache/Beget)
# Основной адрес — nespatmoskva.ru; остальные домены клеятся на него 301-м.

RewriteEngine On

# 1) Всегда https
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2) Без www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# 3) Зеркала → основной домен (адрес и путь сохраняются)
#    dontsleepmoscow.ru и неспатьмосква.рф (xn--80aafk0alelgtej4k.xn--p1ai)
RewriteCond %{HTTP_HOST} ^dontsleepmoscow\.ru$ [NC,OR]
RewriteCond %{HTTP_HOST} ^xn--80aafk0alelgtej4k\.xn--p1ai$ [NC]
RewriteRule ^ https://nespatmoskva.ru%{REQUEST_URI} [L,R=301]

ErrorDocument 404 /404.html

# Кэширование статики (видео и фото тяжёлые — держим в кэше браузера)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html            "access plus 0 seconds"
  ExpiresByType text/css             "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg           "access plus 1 year"
  ExpiresByType image/png            "access plus 1 year"
  ExpiresByType image/svg+xml        "access plus 1 year"
  ExpiresByType video/mp4            "access plus 1 year"
  ExpiresByType font/woff2           "access plus 1 year"
</IfModule>

# Сжатие (jpeg/png/mp4 уже сжаты — не трогаем)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Видео должно поддерживать перемотку по диапазонам
<IfModule mod_headers.c>
  <FilesMatch "\.mp4$">
    Header set Accept-Ranges bytes
  </FilesMatch>
</IfModule>

DirectoryIndex index.html
